# Copy to .env.local. Both keys are optional — the app runs with neither,
# using OpenStreetMap for discovery and Nominatim for geocoding.

# Google Cloud API key with Places API (New) and Geocoding API enabled.
# Adds Google Places as a second discovery source and switches geocoding to
# Google. Without it the app is OSM-only.
GOOGLE_MAPS_API_KEY=

# Raises the PageSpeed Insights quota used by the optional Lighthouse toggle.
# The toggle works without it, just at a lower rate limit.
PAGESPEED_API_KEY=
